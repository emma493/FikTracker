{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile records stored under users collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "FikFapAccount": {
      "title": "FikFapAccount",
      "description": "FikFap tracked account details and metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fikfapEmail": { "type": "string" },
        "fikfapUsername": { "type": "string" },
        "label": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "error", "syncing"] },
        "errorMessage": { "type": "string" },
        "totalVideos": { "type": "number" },
        "totalLinkClicks": { "type": "number" },
        "totalViews": { "type": "number" },
        "totalFollowers": { "type": "number" },
        "totalLikes": { "type": "number" },
        "todayVideos": { "type": "number" },
        "todayLinkClicks": { "type": "number" },
        "todayViews": { "type": "number" },
        "targetBioLink": { "type": "string" },
        "proxy": { "type": "string" },
        "syncFrequency": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "createdAt": { "type": "string" },
        "recentVideos": { "type": "array" },
        "syncLogs": { "type": "array" }
      },
      "required": ["id", "userId", "fikfapEmail", "status", "totalVideos", "totalLinkClicks", "lastUpdated", "createdAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user application preferences and scraper configurations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "autoRefreshIntervalMinutes": { "type": "number" },
        "notifyOnError": { "type": "boolean" },
        "notificationEmail": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "defaultProxy": { "type": "string" },
        "autoSyncEnabled": { "type": "boolean" }
      },
      "required": ["userId", "autoRefreshIntervalMinutes"]
    }
  },
  "firestore": {
    "rules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /users/{userId} {\n      allow read, write: if true;\n    }\n    match /accounts/{accountId} {\n      allow read, write: if true;\n    }\n    match /settings/{userId} {\n      allow read, write: if true;\n    }\n  }\n}"
  }
}
