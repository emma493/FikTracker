rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    // User settings collection
    match /settings/{userId} {
      allow read, write: if true;
    }
  }
}

